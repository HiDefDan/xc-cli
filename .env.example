XTREAM_SERVER=http://example.com
XTREAM_USER=your_username
XTREAM_PASS=your_password

WG_CONFIG_PATH=./config/wireguard/surfshark.conf
# managed: this app brings the tunnel up/down itself via wg-quick
# external: you're running your own VPN (e.g. Surfshark's app) and asserting it's on
VPN_MODE=managed

MPV_PATH=mpv
# fit: windowed, scaled to ~90% of screen (default) | fullscreen | native: mpv's own default sizing
MPV_WINDOW_MODE=fit

# TMDB (themoviedb.org) — used to rank/dedupe search results by canonical
# episode counts (series) and to merge duplicate sources across providers.
# Either a v3 API key or a v4 read-access token works.
TMDB_API_KEY=your_tmdb_api_key

# Where "Download" saves files. Defaults to ~/Downloads/xc-cli if unset.
DOWNLOAD_DIR=~/Downloads/xc-cli
