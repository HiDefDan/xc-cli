XTREAM_SERVER=http://example.com
XTREAM_USER=your_username
XTREAM_PASS=your_password

WG_CONFIG_PATH=./config/wireguard/surfshark.conf
# managed: this app brings the tunnel up/down itself via wg-quick
# external: you're running your own VPN (e.g. Surfshark's app) and asserting it's on
VPN_MODE=managed

MPV_PATH=mpv
# fit: windowed, scaled to ~90% of screen (default) | fullscreen | native: mpv's own default sizing
MPV_WINDOW_MODE=fit
